n = float(input())
if n==int(n):
    print(int(n), int(n), int(n))

elif n>0:
    if n>=(int(n)+0.5):
        print(int(n)+1, int(n), int(n)+1)
    elif n<(int(n)+0.5):
        print(int(n)+1, int(n), int(n))

elif n<0:
    if n>(int(n)-0.5):
        print(int(n), int(n)-1, int(n))
    elif n<=(int(n)-0.5):
        print(int(n), int(n)-1, int(n)-1)
